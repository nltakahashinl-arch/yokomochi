rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /schedules/{id} { allow read, create, update, delete: if true; } match /histories/{id} { allow read, create: if true; allow update, delete: if false; } match /weekConfigs/{id} { allow read, create, update: if true; allow delete: if false; } match /settings/{id} { allow read, create, update: if true; allow delete: if false; } } }
